.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

.content {
  padding: 30rpx;
}

.header-card {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.level-badge {
  padding: 10rpx 25rpx;
  background: #fff;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #10B981;
}

.year-text, .session-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.info-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.award-name {
  font-size: 28rpx;
  color: #10B981;
}

.detail-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.detail-item {
  display: flex;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-label {
  width: 160rpx;
  font-size: 26rpx;
  color: #999;
}

.detail-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.desc-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.desc-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.desc-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

.time-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 30rpx;
}

.time-text {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 5rpx;
}

.time-text:last-child {
  margin-bottom: 0;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 50vh;
  color: #999;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  background: #f5f5f5;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.action-btn.primary {
  background: #10B981;
  color: #fff;
}

.action-btn.favorited {
  background: #fef3c7;
  color: #f59e0b;
}

.action-icon {
  font-size: 36rpx;
}
