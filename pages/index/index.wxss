.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 100rpx;
}

.header {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  padding: 80rpx 30rpx 60rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.search-section {
  padding: 30rpx;
  margin-top: -40rpx;
}

.search-box {
  display: flex;
  background: #fff;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  padding: 10rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.search-btn {
  width: 80rpx;
  height: 80rpx;
  background: #10B981;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
}

.search-icon {
  font-size: 36rpx;
}

.quick-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-top: 20rpx;
}

.filter-tag {
  background: #fff;
  padding: 15rpx 30rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.filter-tag:active {
  background: #10B981;
  color: #fff;
}

.stats-section {
  display: flex;
  padding: 0 30rpx;
  gap: 20rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.stat-value {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #10B981;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}

.section {
  padding: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 26rpx;
  color: #10B981;
}

.hot-awards {
  white-space: nowrap;
}

.award-card {
  display: inline-block;
  width: 240rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 25rpx;
  margin-right: 20rpx;
  vertical-align: top;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.award-badge {
  display: inline-block;
  padding: 5rpx 15rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  color: #fff;
  margin-bottom: 15rpx;
}

.award-name {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.award-recipient {
  display: block;
  font-size: 22rpx;
  color: #666;
  margin-bottom: 5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.award-year {
  font-size: 20rpx;
  color: #999;
}

.latest-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.latest-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.latest-item:last-child {
  border-bottom: none;
}

.latest-content {
  flex: 1;
  overflow: hidden;
}

.latest-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.latest-info {
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.latest-arrow {
  font-size: 40rpx;
  color: #ccc;
}

.query-info {
  padding: 20rpx 30rpx;
  text-align: center;
}

.query-text {
  font-size: 22rpx;
  color: #999;
}
