.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.search-header {
  background: #fff;
  padding: 20rpx 30rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.search-box {
  display: flex;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 10rpx;
}

.search-input {
  flex: 1;
  height: 70rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.search-btn {
  background: #10B981;
  color: #fff;
  padding: 0 40rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.filter-bar {
  background: #fff;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-items {
  display: inline-flex;
  padding: 0 20rpx;
  gap: 20rpx;
}

.filter-item {
  display: inline-block;
  padding: 15rpx 30rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
}

.filter-item.active {
  background: #10B981;
  color: #fff;
}

.result-count {
  padding: 20rpx 30rpx;
  font-size: 24rpx;
  color: #999;
}

.result-list {
  height: calc(100vh - 280rpx);
  padding: 0 30rpx;
}

.result-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.item-header {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-bottom: 15rpx;
}

.item-level {
  padding: 5rpx 15rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  color: #fff;
}

.item-year {
  font-size: 22rpx;
  color: #999;
}

.item-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.item-award {
  display: block;
  font-size: 26rpx;
  color: #10B981;
  margin-bottom: 8rpx;
}

.item-recipient {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 5rpx;
}

.item-organization {
  font-size: 24rpx;
  color: #666;
}

.loading {
  padding: 30rpx;
  text-align: center;
  color: #999;
}

.no-more {
  padding: 30rpx;
  text-align: center;
  color: #999;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
}
