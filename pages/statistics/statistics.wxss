.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 100rpx;
}

.stats-header {
  background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
  padding: 80rpx 30rpx 60rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.stats-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.stats-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.tabs {
  display: flex;
  background: #fff;
  margin: -30rpx 30rpx 20rpx;
  border-radius: 20rpx;
  padding: 10rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 15rpx;
}

.tab-item.active {
  background: #8b5cf6;
  color: #fff;
}

.tab-content {
  padding: 0 30rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.stat-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #8b5cf6;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.chart-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.chart-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.pie-chart {
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

.pie {
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  justify-content: center;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #666;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.filter-row {
  margin-bottom: 20rpx;
}

.filter-picker {
  background: #fff;
  padding: 20rpx 30rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #333;
}

.bar-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 300rpx;
  padding: 20rpx 0;
}

.bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.bar {
  width: 40rpx;
  background: linear-gradient(180deg, #8b5cf6 0%, #6366f1 100%);
  border-radius: 10rpx 10rpx 0 0;
  position: relative;
  min-height: 20rpx;
  transition: height 0.3s ease;
}

.bar-value {
  position: absolute;
  top: -30rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: #8b5cf6;
  font-weight: bold;
}

.bar-label {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #999;
}

.search-box {
  display: flex;
  background: #fff;
  border-radius: 40rpx;
  padding: 10rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.search-input {
  flex: 1;
  height: 70rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.search-btn {
  background: #8b5cf6;
  color: #fff;
  padding: 0 40rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.person-result, .org-result {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.result-count {
  font-size: 26rpx;
  color: #8b5cf6;
}

.result-list {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.result-item {
  display: flex;
  justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-item:last-child {
  border-bottom: none;
}

.item-award {
  font-size: 28rpx;
  color: #333;
}

.item-year {
  font-size: 24rpx;
  color: #999;
}

.top-list {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.top-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.top-item {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.top-item:last-child {
  border-bottom: none;
}

.top-rank {
  width: 40rpx;
  height: 40rpx;
  background: #f0f0f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #666;
  margin-right: 20rpx;
}

.top-item:nth-child(1) .top-rank {
  background: #ef4444;
  color: #fff;
}

.top-item:nth-child(2) .top-rank {
  background: #f97316;
  color: #fff;
}

.top-item:nth-child(3) .top-rank {
  background: #eab308;
  color: #fff;
}

.top-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.top-count {
  font-size: 26rpx;
  color: #8b5cf6;
}
